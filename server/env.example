PORT=add_your_port

NODE_ENV=add_your_environment

MONGO_USER=add_your_mongoDB_username
MONGO_PASSWORD=add_your_mongoDB_password
MONGODB_URI=add_mongoDB_uri



JWT_ACCESS_SECRET=add_your_secret
JWT_ACCESS_EXPIRES_IN=add_your_time
JWT_REFRESH_SECRET=add_your_secret
JWT_REFRESH_EXPIRES_IN=add_your_time


# Gmail: host smtp.gmail.com, port 465 (SSL). SMTP_PASS is a Google App Password.
# SMTP_USER and SMTP_FROM_EMAIL must be the same Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.account@gmail.com
SMTP_PASS=your_gmail_app_password

SMTP_FROM_NAME=Daily Memo
SMTP_FROM_EMAIL=your.account@gmail.com 

CLIENT_URL=add_your_client/frontend_url
APP_URL=add_single_frontend_url_used_in_emails